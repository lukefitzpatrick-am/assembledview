        "canonicals": ["site_number"]
      },
      {
        "id": "panel_name",
        "label": "Panel name",
        "dest": "line_item_panels.panel_name",
        "kind": "column",
        "canonicals": ["panel_name"]
      },
      {
        "id": "latitude",
        "label": "Latitude",
        "dest": "line_item_panels.latitude",
        "kind": "column",
        "canonicals": ["latitude"]
      },
      {
        "id": "longitude",
        "label": "Longitude",
        "dest": "line_item_panels.longitude",
        "kind": "column",
        "canonicals": ["longitude"]
      },
      {
        "id": "size",
        "label": "Size",
        "dest": "attrs.size",
        "kind": "column",
        "canonicals": ["size"]
      },
      {
        "id": "panel_size",
        "label": "Panel size",
        "dest": "line_item_panels.size",
        "kind": "column",
        "canonicals": ["size"]
      },
      {
        "id": "buyType",
        "label": "Buy Type",
        "dest": "line_items.buyType",
        "kind": "column",
        "canonicals": ["buy_type", "buyType"],
        "controlled": { "vocabulary": "ooh_buy_type" }
      },
      {
        "id": "type",
        "label": "Type",
        "dest": "attrs.type",
        "kind": "column",
        "canonicals": ["type", "digital_spec"]
      },
      {
        "id": "buying_demo",
        "label": "Buying Demo",
        "dest": "line_items.buyingDemo",
        "kind": "column",
        "canonicals": ["buying_demo", "buyingDemo"]
      },
      {
        "id": "placement",
        "label": "Placement",
        "dest": "attrs.placement",
        "kind": "column",
        "canonicals": ["placement"]
      },
      {
        "id": "village_name",
        "label": "Village",
        "dest": "line_item_panels.village_name",
        "kind": "column",
        "canonicals": ["village_name"]
      },
      {
        "id": "illumination",
        "label": "Illumination",
        "dest": "line_item_panels.illumination",
        "kind": "column",
        "canonicals": ["illumination"]
      },
      {
        "id": "rotation_seconds",
        "label": "Rotation seconds",
        "dest": "line_item_panels.rotation_seconds",
        "kind": "column",
        "canonicals": ["rotation_seconds"]
      },
      {
        "id": "charges",
        "label": "Charges",
        "dest": "reconciliation.charges",
        "kind": "money",
        "canonicals": ["charge:production", "charge:installation"]
      },
      {
        "id": "lunar_rate",
        "label": "Lunar rate (cross-check)",
        "dest": "warnings",
        "kind": "column",
        "canonicals": ["media_rate:lunar"]
      }
    ],
    "system_waivers": [
      {
        "id": "type",
        "default": "",
        "reason": "editor-card field; save path does not validate"
      },
      {
        "id": "buyType",
        "default": "fixed_cost",
        "reason": "canonical OOH vocab"
      }
    ]
  },
