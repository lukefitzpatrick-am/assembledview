      },
      {
        "id": "burst_dates",
        "label": "Burst dates",
        "dest": "bursts.startDate",
        "kind": "grid"
      }
    ],
    "enrich": [
      {
        "id": "site_number",
        "label": "Site number",
        "dest": "line_item_panels.site_number",
