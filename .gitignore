# dependencies
/node_modules

# next.js
/.next/
/out/
*.lnk

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsc-out.txt
.vercel
.env*.local

# local/dev-only — track shared editor settings only
/.vscode/*
!/.vscode/settings.json
/secrets/
snowflake.log
.superpowers/

# Transient tooling output (audit cleanup)
filetree.txt
lint-full.txt
*.log

.cursor/
.claude-scratch/
.claude-scratch-export.pptx
tmp-slide16-test.pptx
*.zip
xano-metadata-token.txt

# Xano / migration snapshots (large; regenerate via npm run xano:export)
/exports/

_claude_repo_snapshot.tgz
*.tgz

.worktrees/

# O1 / local scratch — never track
/_to_delete/
/tmp/
scripts/ps1-sec-live-probe.mjs

# drizzle-kit pull scratch
/db/_pull_live/

# O5 KPI percent-unit scan CSVs (regenerate via npm run scan:kpi-percent-units)
/scripts/data/kpi-percent-unit-scan/

# PC6 matcher replay output (regenerate via npm run replay:pc6-matcher)
/pc6-matcher-replay-report.json

# C1 full-scope drift report (regenerate via npm run test:c1-fullscope-drift)
scripts/c1-fullscope-drift-report.csv

