{
  "ooh": {
    "media_type": "ooh",
    "card_field_ids": [
      "publisher",
      "format",
      "buyType",
      "type",
      "size",
      "market",
      "buying_demo",
      "placement",
      "media_money",
      "burst_dates"
    ],
    "detail_table": {
      "id": "line_detail",
      "label": "Line detail",
      "field_ids": [
        "site_number",
        "panel_name",
        "latitude",
        "longitude",
        "panel_size",
        "illumination",
        "rotation_seconds",
        "village_name"
      ]
    },
    "money_detail_ids": ["charges", "lunar_rate"],
    "required": [
      {
        "id": "publisher",
        "label": "Network",
        "dest": "line_items.publisher",
        "kind": "profile"
      },
      {
        "id": "format",
        "label": "Format",
        "dest": "attrs.format",
        "kind": "column",
        "canonicals": ["format", "publisher_format_name"],
        "controlled": { "vocabulary": "ooh_format" }
      },
      {
        "id": "market",
        "label": "Market",
        "dest": "line_items.market",
        "kind": "column",
        "canonicals": ["market", "state", "geography"]
      },
      {
        "id": "buy_granularity",
        "label": "Buy granularity",
        "dest": "attrs.buy_granularity",
