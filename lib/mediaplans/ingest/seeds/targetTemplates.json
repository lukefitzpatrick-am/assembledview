      },
      {
        "id": "media_money",
        "label": "Media money",
        "dest": "bursts.budget",
        "kind": "money",
        "canonicals": [
          "media_rate:weekly",
          "media_rate:lunar",
          "media_rate:per_spot",
          "media_amount:stated"
