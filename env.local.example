AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN.auth0.com
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH0_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://YOUR_AUTH0_API_AUDIENCE
# Reuse the same Auth0 application as production. Fill in the actual secrets.
AUTH0_CLIENT_ID=__set_in_vercel__
AUTH0_CLIENT_SECRET=__set_in_vercel__
AUTH0_SECRET=__set_in_vercel__

# Ava (Claude) — ANTHROPIC_API_KEY required; AVA_ENGINE=off is an optional kill-switch
ANTHROPIC_API_KEY=__set_in_vercel__
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AVA_ENGINE=off

# Codex v2 (Postgres Tasks) — off unless exactly on. Routes 404 when unset.
# CODEX_V2=on

# Plan working drafts (PC7 / Stage 2b) — local default off; set on for autosave chrome.
# ON: 3s IndexedDB + 15s server autosave, soft "Save draft", pill "autosaved Ns ago".
# OFF: that chrome off. Existing plan_working_drafts rows are retained (not deleted);
#      load offer (Resume · Compare · Discard) stays reachable. Interim
#      SAVE_PUBLISHES_IMMEDIATELY: Save publishes (no working-draft save path).
#      Do not set on Vercel from Cursor — Luke flips prod at merge.
# NEXT_PUBLIC_PLAN_DRAFTS=on

# M365 Graph provisioning (M5) — default OFF. Wrappers throw when unset/off.
# Entra app permissions + cert: docs/brain/modules/m365.md (Luke registers in portal).
# NEXT_PUBLIC_M365_PROVISIONING=on
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=   # local/dev only; prod uses certificate credential

# AVA Postgres reads — transaction pooler (port 6543) as ava_readonly ONLY.
# NEVER the postgres/owner connection (that is DATABASE_URL / DIRECT_URL).
# Password is set in the Supabase dashboard/psql after applying db/migrations/0003_ava_readonly.sql.
# AVA_DATABASE_URL=postgresql://ava_readonly:PASSWORD@YOUR_PROJECT.pooler.supabase.com:6543/postgres

# Xano API bases
XANO_MEDIA_PLANS_BASE_URL=https://YOUR-XANO-HOST.xano.io/api:YOUR_MEDIA_PLANS_API_GROUP
XANO_MEDIAPLANS_BASE_URL=https://YOUR-XANO-HOST.xano.io/api:YOUR_MEDIAPLANS_API_GROUP
XANO_CLIENTS_BASE_URL=https://YOUR-XANO-HOST.xano.io/api:YOUR_CLIENTS_API_GROUP
XANO_PUBLISHERS_BASE_URL=REPLACE_WITH_XANO_PUBLISHERS_BASE_URL
XANO_SCOPES_BASE_URL=REPLACE_WITH_XANO_SCOPES_BASE_URL
XANO_MEDIA_DETAILS_BASE_URL=REPLACE_WITH_XANO_MEDIA_DETAILS_BASE_URL
XANO_MEDIA_CONTAINERS_BASE_URL=REPLACE_WITH_XANO_MEDIA_CONTAINERS_BASE_URL
# Optional: api group base for Finance Forecast immutable snapshots (see docs/finance-forecast-snapshots-xano.md)
XANO_FINANCE_FORECAST_SNAPSHOTS_BASE_URL=
# Optional overrides for Xano function paths (defaults: finance_forecast_snapshots_list, finance_forecast_snapshot_lines)
# XANO_FINANCE_FORECAST_SNAPSHOTS_LIST_PATH=
# XANO_FINANCE_FORECAST_SNAPSHOTS_LINES_PATH=
# Optional: api group for mutable revenue_forecast_lines targets (falls back to XANO_CLIENTS_BASE_URL)
# XANO_FINANCE_FORECAST_TARGETS_BASE_URL=
# XANO_FINANCE_FORECAST_TARGETS_PATH=revenue_forecast_lines
# Xano assistant endpoint (full URL) + optional base
XANO_BASE_URL=REPLACE_WITH_XANO_ASSISTANT_ENDPOINT
# Optional override for the AI assistant endpoint (full URL)
XANO_ASSISTANT_ENDPOINT=

# Data / write backends. Default postgres — an unset variable must not select
# the retired Xano path. `xano` remains a legal explicit value (ETL / shadow-diff)
# and warns once per process. Per-domain: DATA_BACKEND_<DOMAIN> (e.g. PLANS).
# DATA_BACKEND=postgres
# WRITE_BACKEND=postgres

# Plan-save Xano write-back after Postgres commit. Off by default; the mirror
# cannot serve as a rollback target because post-cutover MBAs do not exist in Xano.
# Only exactly `true` (trimmed, lowercased) enables it. Independent of DATA_BACKEND / WRITE_BACKEND.
# XANO_MIRROR_ENABLED=true

# Auth0 Management API (Machine-to-Machine)
AUTH0_MGMT_CLIENT_ID=__set_in_vercel__
AUTH0_MGMT_CLIENT_SECRET=__set_in_vercel__
AUTH0_MGMT_AUDIENCE=https://YOUR_AUTH0_DOMAIN.auth0.com/api/v2/
AUTH0_DB_CONNECTION=REPLACE_WITH_DB_CONNECTION_NAME
AUTH0_MGMT_DOMAIN=YOUR_AUTH0_DOMAIN.auth0.com

# Role / client claims (used in the Auth0 Post-Login Action)
AUTH0_ROLE_NAMESPACE=https://YOUR_APP_DOMAIN/roles
AUTH0_CLIENT_NAMESPACE=https://YOUR_APP_DOMAIN/client
# If your Auth0 action emits alternate claim namespaces in production, set these to match.
# AUTH0_ROLE_NAMESPACE=https://YOUR_APP_DOMAIN/roles
# AUTH0_CLIENT_NAMESPACE=https://YOUR_APP_DOMAIN/client
AUTH0_ROLE_ADMIN_ID=REPLACE_WITH_AUTH0_ADMIN_ROLE_ID
AUTH0_ROLE_CLIENT_ID=REPLACE_WITH_AUTH0_CLIENT_ROLE_ID

# Admin allowlist (comma-separated emails)
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Operators who may create/promote Auth0 users to the `admin` role (comma-separated).
# Empty/unset = deny ALL admin grants (fail closed). Not a third app role — see lib/auth/canGrantAdminRole.ts.
# SUPERADMIN_EMAIL_ALLOWLIST=ops@example.com

# Finance sections IA (FN7): always on — sidebar expands Finance into Invoicing /
# Costs / Investment / Forecasting; /finance rewrites to sections landing;
# ?tab= deep-links redirect to section paths. Rollback: git revert FN7 commit
# (see docs/superpowers/fn7-finance-sections-cutover-2026-08-01.md).

# Email (primary: SendGrid)
SENDGRID_API_KEY=__set_in_vercel__
EMAIL_FROM=REPLACE_WITH_FROM_EMAIL
# Optional comma-separated ops/digest recipients (default: ops@example.com)
# OPS_EMAIL_TO=ops@example.com

# Vercel cron shared secret (x-cron-secret or Authorization: Bearer)
CRON_SECRET=__set_in_vercel__

# Optional SMTP fallback (used only if SENDGRID_API_KEY is missing)
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_SECURE=false

# Xano user management
XANO_USERS_ENDPOINT=REPLACE_WITH_XANO_USERS_ENDPOINT
XANO_API_KEY=__set_in_vercel__

# Vercel Blob (private store, SYD1 — creative assets + AVA MI workbook export)
# Local: set below, then restart `npm run dev` (env is read at server start only).
# Deployed: connect the Blob store in Vercel (Storage), or add this var under
# Project Settings → Environment Variables (no quotes), then redeploy.
# BLOB_STORE_ID is optional metadata — app code uses the token only.
BLOB_READ_WRITE_TOKEN=__set_in_vercel__

# Creative mockup v2 — live page screenshots (ScreenshotOne) + signed frame URLs
# Official names (preferred):
SCREENSHOTONE_ACCESS_KEY=__set_in_vercel__
SCREENSHOTONE_SECRET=__set_in_vercel__
# Also accepted: SCREENSHOT_ACCESS / SCREENSHOT_SECRET
CREATIVE_FRAME_SIGNING_SECRET=__set_in_vercel__

#
# Snowflake
SNOWFLAKE_ACCOUNT=REPLACE_ME
SNOWFLAKE_USERNAME=REPLACE_ME
# PKCS8 PEM with BEGIN/END lines; escape newlines for .env usage
SNOWFLAKE_PRIVATE_KEY=REPLACE_WITH_PKCS8_PRIVATE_KEY
SNOWFLAKE_ROLE=REPLACE_ME
SNOWFLAKE_WAREHOUSE=REPLACE_ME
SNOWFLAKE_DATABASE=YOUR_SNOWFLAKE_DATABASE
SNOWFLAKE_SCHEMA=YOUR_SNOWFLAKE_SCHEMA

# Vercel recommendations (fail fast under 15s)
# SNOWFLAKE_ACQUIRE_TIMEOUT_MS=7000
# SNOWFLAKE_EXECUTE_TIMEOUT_MS=8000
# SNOWFLAKE_MAX_RETRY_TIME_MS=12000
# SNOWFLAKE_POOL_WARM_SIZE=0
